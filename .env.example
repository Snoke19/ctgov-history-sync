# ============================================
# Clinical Trials Scraper - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# All values are optional and have sensible defaults

# ============================================
# API ENDPOINTS
# ============================================
API_BASE_URL='https://clinicaltrials.gov/api/v2/studies'
API_DETAIL_URL='https://clinicaltrials.gov/api/int/studies'

# ============================================
# PERFORMANCE SETTINGS
# ============================================
PAGE_SIZE=1000
CONCURRENCY=40
FETCH_TIMEOUT_MS=10000

# ============================================
# PROXY CONFIGURATION
# ============================================
PROXY_URLS=""
PROXY_POOL_CONNECTIONS=10
MAX_POOL_CONNECTIONS=100
PROXY_POOL_PIPELINING=1
PROXY_POOL_KEEP_ALIVE_TIMEOUT_MS=300000
PROXY_POOL_HEADERS_TIMEOUT_MS=15000
PROXY_POOL_BODY_TIMEOUT_MS=45000
PROXY_POOL_CONNECT_TIMEOUT_MS=5000

# ============================================
# RATE LIMITING (Token Bucket)
# ============================================
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_WINDOW=60000
ACQUIRE_TIMEOUT=30000

# ============================================
# RETRY CONFIGURATION
# ============================================
MAX_RETRIES=3
RETRYABLE_STATUS_CODES=408,429,500,502,503,504
RETRY_BASE_DELAY_MS=500
BACKOFF_CAP_MS=15000
RETRY_ON_TIMEOUT=true
RETRY_ON_NETWORK_ERROR=true

# ============================================
# APP ENVIRONMENT
# ============================================
NODE_ENV=dev

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# USER AGENT
# ============================================
DEFAULT_USER_AGENT=browser/1.0

LOG_TO_FILE=true